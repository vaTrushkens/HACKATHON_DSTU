# Скопируйте в .env и поправьте под себя
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL (docker-compose поднимает с этими же параметрами)
POSTGRES_DB=cashflow
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=cashflow
DATABASE_URL=postgres://cashflow:cashflow@localhost:5433/cashflow

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api

# путь к датасету кейса (для manage.py import_dataset)
DATASET_DIR=../cashflow_dataset_participants

FORECAST_DEFAULT_HORIZON=60
FORECAST_N_PATHS=1000

# LLM-ассистент (подключается позже): none | anthropic | openai | local
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=

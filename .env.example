# Скопируйте в .env и поправьте под себя
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL (docker-compose поднимает с этими же параметрами)
POSTGRES_DB=cashflow
POSTGRES_USER=cashflow
POSTGRES_PASSWORD=cashflow
DATABASE_URL=postgres://cashflow:cashflow@localhost:5433/cashflow

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000/api

# путь к датасету кейса (для manage.py import_dataset)
DATASET_DIR=../cashflow_dataset_participants

FORECAST_DEFAULT_HORIZON=60
FORECAST_N_PATHS=1000

# Внешние интеграции (необязательно; ключи можно задать и по компании в «Календарь платежей → Источники данных»)
DADATA_API_KEY=
BANK_API_URL=
BANK_API_TOKEN=

# LLM-ассистент: локальная модель через Ollama (чат на сайте + Telegram-бот)
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e4b
LLM_BASE_URL=http://localhost:11434
# адрес Ollama для контейнеров; чтобы использовать Ollama, установленную на хосте: http://host.docker.internal:11434
LLM_BASE_URL_DOCKER=http://ollama:11434
LLM_TIMEOUT=180
# router — выбор инструмента структурированным JSON без размышлений (быстро; для компактных моделей вроде gemma4:e2b/e4b)
# native — нативный function calling с thinking (надёжно у моделей от ~8B, например gemma4:latest; в 2–4 раза медленнее)
LLM_MODE=router
LLM_THINK=1

# Telegram-бот: токен от @BotFather (без него сервис telegram просто не стартует)
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_INTERVAL_MIN=30
TELEGRAM_REMIND_DAYS=3
